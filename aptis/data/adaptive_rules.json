[{"rule_id":"R01","trigger":"Wrong answer","target_scope":"Same primary concept","action":"Insert 1 related item within next 3 questions","weight_count":"2","purpose":"Immediate corrective practice","status":"ACTIVE"},{"rule_id":"R02","trigger":"Two errors in one family within 10 items","target_scope":"Same family node","action":"Generate a 3-item microset from the family","weight_count":"3","purpose":"Build collocation/grammar-family pattern","status":"ACTIVE"},{"rule_id":"R03","trigger":"Three correct answers in a row","target_scope":"Contrast edge","action":"Present one CONFUSABLE_WITH or CONTRASTS_WITH item","weight_count":"1","purpose":"Test discrimination rather than recall","status":"ACTIVE"},{"rule_id":"R04","trigger":"Mastery ≥ 0.80 and attempts ≥ minimum","target_scope":"Parent/topic node","action":"Reduce sampling weight to 0.40","weight_count":"0.4","purpose":"Move mastered concepts to maintenance","status":"ACTIVE"},{"rule_id":"R05","trigger":"Mastery < 0.60","target_scope":"Primary concept","action":"Increase sampling weight to 1.80","weight_count":"1.8","purpose":"Prioritise weak concepts","status":"ACTIVE"},{"rule_id":"R06","trigger":"Ambiguity Risk = MEDIUM_CONTEXT_DEPENDENT","target_scope":"Guided practice only","action":"Exclude from timed mock; show explanation after answer","weight_count":"0","purpose":"Avoid unfair single-answer scoring","status":"ACTIVE"},{"rule_id":"R07","trigger":"Same Template Key already selected","target_scope":"Alternative template","action":"Reject duplicate template in the same test","weight_count":"0","purpose":"Prevent repetitive test forms","status":"ACTIVE"},{"rule_id":"R08","trigger":"Review due date reached","target_scope":"Same concept or sibling","action":"Schedule by intervals 1,3,7,14,30 days","weight_count":"1","purpose":"Spaced repetition","status":"ACTIVE"},{"rule_id":"R09","trigger":"Grammar/Vocabulary imbalance","target_scope":"Domain node","action":"Target 50:50 in Full Core mode","weight_count":"1","pu